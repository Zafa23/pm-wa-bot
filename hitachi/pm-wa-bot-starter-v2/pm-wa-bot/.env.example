# Salin menjadi .env lalu isi.
# Nomor WhatsApp ADMIN: angka saja, tanpa +, spasi, atau tanda -
ADMIN_NUMBERS=628xxxxxxxxxx,628yyyyyyyyyy

# Chat/grup tujuan reminder 00:00 WIB.
# Untuk sementara boleh dikosongkan; bot tetap bisa dipakai untuk command.
# Format grup: 120xxxxxxxx@g.us
REMINDER_CHAT_JID=

# Zona waktu reminder.
TZ=Asia/Jakarta

# Nama periode PM yang sedang berjalan.
PM_PERIOD=2026-08
